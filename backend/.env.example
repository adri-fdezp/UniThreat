# UniThreat API Keys — copy this file to .env and fill in your keys

# Required for Claude Research module and Attack Analyzer
ANTHROPIC_API_KEY=your_anthropic_key_here

# Required for the Brave Search module. Every query uses paid API credit.
# Get a key at https://brave.com/search/api/
BRAVE_API_KEY=your_brave_key_here

# Required for the Instagram module — Instagram blocks anonymous lookups now,
# so a logged-in session is required. Set this to the Instagram account you
# logged the session in with (see the setup steps in
# backend/modules/social/instagram_module.py).
INSTAGRAM_USERNAME=your_instagram_username_here

# Optional — override the session file path. Defaults to instaloader's own
# default location if unset.
# INSTAGRAM_SESSION_FILE=
